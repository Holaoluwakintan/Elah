{
  "name": "elah-warrior",
  "version": "2.0.0",
  "description": "ELAH WARRIOR — 3D Biblical Combat Saga with Real-Time Multiplayer Realm",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
